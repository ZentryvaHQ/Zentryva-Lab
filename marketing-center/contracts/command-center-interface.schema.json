{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zentryva://marketing-center/command-center-interface/v1",
  "title": "Marketing Center Command Center Status Contract",
  "type": "object",
  "required": ["work_id","tenant_id","component","state","updated_at","evidence_refs"],
  "properties": {
    "work_id":{"type":"string"},
    "tenant_id":{"type":"string"},
    "component":{"type":"string"},
    "state":{"enum":["BACKLOG","READY","IN_PROGRESS","TESTING","VERIFIED","COMPLETE","BLOCKED_AWAITING_RICHARD","FAILED","DIAGNOSING","RETESTING"]},
    "updated_at":{"type":"string","format":"date-time"},
    "heartbeat_at":{"type":["string","null"],"format":"date-time"},
    "cost_usd":{"type":"number","minimum":0},
    "blocker_id":{"type":["string","null"]},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "message":{"type":["string","null"]}
  },
  "additionalProperties": false
}

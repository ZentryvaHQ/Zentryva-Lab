{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zentryva://marketing-center/tenant/v1",
  "type": "object",
  "required": ["tenant_id", "status", "objectives", "pilot_mode", "budget", "policies", "connectors", "baseline"],
  "properties": {
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["CONFIGURATION_PENDING_VALIDATION", "SHADOW_VALIDATED"]},
    "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pilot_mode": {"const": "SHADOW_THEN_HUMAN_APPROVED"},
    "budget": {"type": "object", "required": ["currency", "paid_media_authorized"], "properties": {"currency": {"const": "USD"}, "paid_media_authorized": {"const": false}}, "additionalProperties": false},
    "policies": {"type": "object", "required": ["production_publish_requires_owner_approval", "spending_requires_owner_approval", "prohibit_sensitive_targeting"], "properties": {"production_publish_requires_owner_approval": {"const": true}, "spending_requires_owner_approval": {"const": true}, "prohibit_sensitive_targeting": {"const": true}}, "additionalProperties": false},
    "connectors": {"type": "object", "maxProperties": 0},
    "baseline": {"type": "object", "required": ["status"], "properties": {"status": {"const": "AWAITING_CLIENT_DATA"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
